# Copy this file to .env.local and fill in values from `supabase status` after `supabase start`
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-local-anon-key

# "mock" (default) uses the in-memory data in packages/db/src/mock — no Supabase needed while building
# out the frontend. Switch to "supabase" once your local Supabase instance is running and seeded.
VITE_DATA_SOURCE=mock

# Used by packages/db (drizzle-kit) and any server-side/edge code — NOT exposed to the browser
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
