# Copy this file to .env.local. Hosted project: Project Settings > API (Project URL + anon public key) — see supabase/HOSTED-SETUP.md.
# Local CLI instead: values from `supabase status` after `supabase start`. Never commit .env.local.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# "mock" (default) uses the in-memory data in packages/db/src/mock — no Supabase needed while building
# out the frontend. Switch to "supabase" once your local Supabase instance is running and seeded.
VITE_DATA_SOURCE=mock

# Mock mode only: which seeded employee the session acts as (owner | admin | staff) — try role-gated UI locally. Default: owner
# VITE_MOCK_ROLE=staff

# Used by packages/db (drizzle-kit) and any server-side/edge code — NOT exposed to the browser.
# Local CLI default shown; for a hosted project use the pooler connection string from the dashboard (contains the DB password).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Offline read cache: always on in Supabase mode; set to "true" to also use it in mock mode (for testing)
# VITE_OFFLINE_CACHE=true
